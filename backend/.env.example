# ====================== LLM =============================
OLLAMA_HOST="http://<url>"
OLLAMA_MODEL=llama3.2:3b


# ================ Embedding Transformer =================
MODEL_TRANSFORMER=intfloat/multilingual-e5-small


# ==================== Vector DB =========================
VECTOR_STORE_PATH="./data/<your_DB>"  --> "../data/vector_store" # if you didn't change the path 
TOP_K="number of retrived chunks"

FRONTEND_ORIGIN="http://localhost:<port>"